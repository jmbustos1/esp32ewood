.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Configuracion sensible por dispositivo (SCOOTER_ID, APN_*, DEVICE_SECRET).
# Cada colega copia include/config_local.example.h a include/config_local.h
# y llena con los valores reales.
include/config_local.h

# sdkconfig regenerado por PlatformIO segun la version instalada de ESP-IDF.
# Versionarlo genera crashes de kconfgen cuando distintos colaboradores tienen
# versiones distintas de ESP-IDF. Cada uno lo regenera al primer `pio run`.
sdkconfig*
!sdkconfig.defaults
